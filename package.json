{
  "name": "restaurant-os",
  "version": "0.1.0",
  "private": true,
  "description": "RestaurantOS — SaaS for restaurant order, kitchen, payment and inventory operations",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --topological build",
    "dev:api": "pnpm --filter @restaurantos/api dev",
    "dev:worker": "pnpm --filter @restaurantos/worker dev",
    "dev:web": "pnpm --filter @restaurantos/web dev",
    "db:generate": "pnpm --filter @restaurantos/database generate",
    "db:migrate": "pnpm --filter @restaurantos/database migrate",
    "db:seed": "pnpm --filter @restaurantos/database seed",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --topological typecheck"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "typescript": "5.6.3"
  },
  "packageManager": "pnpm@9.15.0"
}
